@startuml ER-diagram

entity "Customers" as C {
    * CID : number <<PK>>
    --
    * Name : Text
    * Phone : Number
    * Address : number <<FK>>
}

entity "Address" as A {
    * Address-ID : number <<PK>>
    --
    * Street : Text
    * City : Text
    * State : Text
    * Country : Text
}

entity "Orders" as O {
    *OID : number <<PK>>
    --
    * O-Date : Date
    * O-Total : number
    * CID : number <<FK>>
}

entity "Order-Items" as OI {
    * OID : number <<PK>><<FK>>
    * Line-ID : number <<PK>>
    --
    * QTY : number
    * PID : number <<FK>>
}

entity "Products" as P {
    * PID : number <<PK>>
    --
    * P-Name : Text
    * Price : number
}



A ||--o{ C : has
C ||..o{ O : makes
O ||-r-|{ OI : consist of
OI }o.u.|| P : contains

@enduml